"""Citation type taxonomy, style detection, and VL prompt templates.

Specification: docs/citation-extraction-spec.md

Eleven citation types with distinct structural schemas. Four citation styles
(Chicago notes-bibliography EN, MLA 9th, Slovenian Chicago humanities/Maska,
SIST ISO 690). Style detection from diagnostic markers; type detection by VL.
"""

from __future__ import annotations

import re
from enum import Enum


class CitationType(str, Enum):
    BOOK = "book"
    BOOK_CHAPTER = "book_chapter"
    JOURNAL_ARTICLE = "journal_article"
    MAGAZINE_ARTICLE = "magazine_article"
    NEWSPAPER_ARTICLE = "newspaper_article"
    WEB_SOURCE = "web_source"
    EXHIBITION_CATALOG = "exhibition_catalog"
    INTERVIEW = "interview"
    THESIS_DISSERTATION = "thesis_dissertation"
    SHORT_REFERENCE = "short_reference"
    OTHER = "other"


class CitationStyle(str, Enum):
    CHICAGO_EN = "chicago_en"
    MLA = "mla"
    CHICAGO_SL = "chicago_sl"      # Maska / PNZ / Studia humanitatis
    SIST_ISO690 = "sist_iso690"
    UNKNOWN = "unknown"


# Type-specific field schemas. `required` fields MUST be present and verified
# (substring-matched in segment text) for a record to be kept. Subsidiary
# fields that fail substring check are nulled; the record still survives.
TYPE_SCHEMAS: dict[CitationType, dict] = {
    CitationType.BOOK: {
        "required": ["authors", "title", "year"],
        "fields": [
            "authors", "title", "subtitle", "translator", "editor", "edition",
            "publisher", "city", "year", "pages", "url", "doi",
        ],
    },
    CitationType.BOOK_CHAPTER: {
        "required": ["authors", "chapter_title", "book_title", "year"],
        "fields": [
            "authors", "chapter_title", "book_title", "editors", "translator",
            "publisher", "city", "year", "pages",
        ],
    },
    CitationType.JOURNAL_ARTICLE: {
        "required": ["authors", "article_title", "journal", "year"],
        "fields": [
            "authors", "article_title", "journal", "volume", "issue",
            "year", "pages", "doi", "url",
        ],
        # If publisher or city is set on a journal article, the whole record
        # is rejected — they don't belong here.
        "forbidden": ["publisher", "city"],
    },
    CitationType.MAGAZINE_ARTICLE: {
        "required": ["article_title", "magazine", "date"],
        "fields": [
            "authors", "article_title", "magazine", "date", "pages", "url",
        ],
    },
    CitationType.NEWSPAPER_ARTICLE: {
        "required": ["article_title", "newspaper", "date"],
        "fields": [
            "authors", "article_title", "newspaper", "date", "section",
            "page", "url",
        ],
    },
    CitationType.WEB_SOURCE: {
        "required": ["title", "site_name", "url"],
        "fields": [
            "authors", "title", "site_name", "publisher_or_org",
            "date_published", "accessed_date", "url",
        ],
    },
    CitationType.EXHIBITION_CATALOG: {
        "required": ["title", "venue", "year"],
        "fields": [
            "title", "editors", "curators", "venue", "city", "publisher",
            "year", "exhibition_dates",
        ],
    },
    CitationType.INTERVIEW: {
        "required": ["interviewee", "interviewer", "date"],
        "fields": [
            "interviewee", "interviewer", "title_or_program",
            "publication_or_network", "date", "medium", "url",
        ],
    },
    CitationType.THESIS_DISSERTATION: {
        "required": ["authors", "title", "degree_type", "institution", "year"],
        "fields": [
            "authors", "title", "degree_type", "institution", "year", "url",
        ],
    },
    CitationType.SHORT_REFERENCE: {
        "required": ["marker"],
        "fields": [
            "marker", "author_surname", "short_title", "pages",
            "references_full_citation_id",
        ],
    },
    CitationType.OTHER: {
        "required": [],
        "fields": ["authors", "title", "raw_text", "notes"],
    },
}


# ── Style detection ──────────────────────────────────────────────────────────
# Diagnostic markers from primary sources (PNZ guide for SL Chicago, CMOS for
# EN Chicago, MLA Style Center for MLA, ISO 690 for SIST).

_SL_CHICAGO_MARKERS = re.compile(
    r"\b(?:Glej|Prim\.?|prev\.|ur\.|str\.|letn\.|št\.|v:\s|V:\s)",
    re.IGNORECASE,
)
_SIST_MARKERS = re.compile(
    r"\b(?:ISBN\s*[\d\-Xx]+|ISSN\s*[\d\-]+|dostopno na)\b",
)
_CHICAGO_EN_PARENS = re.compile(
    r"\([A-Z][a-zA-Z\s]{2,}:\s*[A-Z][^)]{3,},\s*\d{4}\)"
)
# MLA: `Container.` followed by `vol. N, no. M, Year` or similar; no parens.
_MLA_MARKER = re.compile(
    r"\bvol\.\s*\d+|no\.\s*\d+|,\s*pp\.\s*\d+",
)


def detect_style(segment_text: str) -> CitationStyle:
    """Per-segment citation style detection by diagnostic markers.

    A segment that matches multiple styles is resolved by priority order:
    SL Chicago markers > SIST markers > Chicago EN parens > MLA markers.
    """
    if not segment_text or len(segment_text) < 4:
        return CitationStyle.UNKNOWN
    if _SL_CHICAGO_MARKERS.search(segment_text):
        return CitationStyle.CHICAGO_SL
    if _SIST_MARKERS.search(segment_text):
        return CitationStyle.SIST_ISO690
    if _CHICAGO_EN_PARENS.search(segment_text):
        return CitationStyle.CHICAGO_EN
    if _MLA_MARKER.search(segment_text):
        return CitationStyle.MLA
    return CitationStyle.UNKNOWN


# ── Short-reference detection (subset of SHORT_REFERENCE type) ───────────────

_IBID_RE = re.compile(
    r"^\s*(?:Ibid\.?|Ibidem|prav tam)\b", re.IGNORECASE,
)
_OP_CIT_RE = re.compile(
    r"^\s*(?:op\.\s*cit\.|loc\.\s*cit\.|nav\.\s*delo|cit\.\s*po)\b",
    re.IGNORECASE,
)
_PAGE_ONLY_RE = re.compile(
    r"^\s*(?:pp?\.|str\.)\s*\d+\s*[-–]?\s*\d*\s*\.?\s*$",
    re.IGNORECASE,
)


def is_short_reference(segment_text: str) -> bool:
    """True if the segment looks like a back-reference, not a full citation."""
    s = segment_text.strip()
    if not s:
        return False
    if _IBID_RE.match(s):
        return True
    if _OP_CIT_RE.match(s):
        return True
    if _PAGE_ONLY_RE.match(s) and len(s) < 30:
        return True
    return False


# ── Regex-based type classifier ──────────────────────────────────────────────
# The 1.6B VL is unreliable for type classification — it hallucinates fields
# when forced into the wrong type. Structural markers (URL, vol+no, "in:"/"v:",
# degree keywords) are deterministic and discriminate cleanly. Saves one VL
# call per citation segment, and crucially, picks the RIGHT type so the
# extract prompt doesn't induce fabrication.

_URL_RE = re.compile(r"https?://")
_DEGREE_RE = re.compile(
    r"\b(?:PhD|MA|MSc|BA|doktorska|magistrsko|diplomsko|"
    r"diss(?:ertation)?\.?|teza|disertacija)\b",
    re.IGNORECASE,
)
_INTERVIEW_RE = re.compile(
    r"\binterview(?:ed|er|ee)?\s+(?:by|with)\b|"
    r"\bintervju\s+(?:z|s)\b",
    re.IGNORECASE,
)
_IN_BOOK_RE = re.compile(
    r"(?:^|\s)(?:in:|v:|In:|V:)\s+[A-ZŠŽČĆĐ]",  # "in: <Capital>" or "v: <Capital>"
)
_VOL_RE = re.compile(r"\b(?:vol\.|letn\.|letnik)\s*\d+", re.IGNORECASE)
_NO_RE = re.compile(r"\b(?:no\.|št\.)\s*\d+", re.IGNORECASE)
_JOURNAL_NUMBER_RE = re.compile(r"\b\d+\s*,\s*no\.\s*\d+", re.IGNORECASE)  # "22, no. 79"
_JOURNAL_SLASH_RE = re.compile(r"\b\d+/\d+\b")  # "79/22" style
_PAGE_RANGE_RE = re.compile(r"\b\d{1,4}\s*[-–]\s*\d{1,4}\b")
_EXHIBITION_RE = re.compile(
    r"\b(?:exh\.\s*cat\.|exhibition\s+catalog(?:ue)?|razstavni\s+katalog)\b",
    re.IGNORECASE,
)
_FULL_DATE_EN_RE = re.compile(
    r"\b(?:January|February|March|April|May|June|July|August|"
    r"September|October|November|December)\s+\d{1,2},?\s+\d{4}\b",
)
_FULL_DATE_SL_RE = re.compile(r"\b\d{1,2}\.\s*\d{1,2}\.\s*\d{4}\b")
_NEWSPAPER_RE = re.compile(
    r"\b(?:Times|Guardian|Post|News|Tribune|Mladina|Delo|Dnevnik|"
    r"Večer|Sobotna priloga|Pogledi)\b",
)


_BIBLIOGRAPHY_AUTHOR_OPENER_RE = re.compile(
    r"^\s*[A-ZŠŽČĆĐ][a-zšžčćđáéíóúýň]{2,}"          # Lastname (capitalised)
    r"(?:\s+[A-Z]\.)*"                              # optional middle initials
    r"\s*,\s+"                                      # comma + space
    r"[A-ZŠŽČĆĐ][a-zšžčćđáéíóúýň]"                # Firstname (capitalised)
)


def detect_author_form(segment_text: str) -> str:
    """Distinguish bibliography-form author block (`Lastname, Firstname.`)
    from footnote-form (`Firstname Lastname,`).

    The shape determines field-extraction semantics — never instruct VL on
    both forms in one prompt; the 1.6B model will conflate them.

    Returns "bibliography" or "footnote".
    """
    s = segment_text or ""
    if _BIBLIOGRAPHY_AUTHOR_OPENER_RE.match(s):
        return "bibliography"
    return "footnote"


# Form-specific author parsing hints. Citation segments have ONE of two
# author orderings — never mix instructions for both in a single prompt.

_FOOTNOTE_HINTS = {
    "author_hint": (
        'list of {"surname":"...","given_name":"..."}. Authors here are in '
        'Firstname Lastname order (e.g. "Jože Prinčič" → surname="Prinčič", '
        'given_name="Jože"). Multiple authors joined by "in" (Slovenian) / '
        '"and" (English) / "&".'
    ),
    "author_hint_editor": (
        'list of {"surname":"...","given_name":"..."}. Editors in Firstname '
        'Lastname order, often followed by "(ur.)" / "(ed.)" / "(eds.)".'
    ),
    "author_hint_single": (
        '{"surname":"...","given_name":"..."}. Name in Firstname Lastname order.'
    ),
}

_BIBLIOGRAPHY_HINTS = {
    "author_hint": (
        'list of {"surname":"...","given_name":"..."}. Authors here are in '
        'Lastname, Firstname order (e.g. "Prinčič, Jože" → surname="Prinčič", '
        'given_name="Jože"). Multiple authors separated by "and" / "in".'
    ),
    "author_hint_editor": (
        'list of {"surname":"...","given_name":"..."}. Editors in '
        'Lastname, Firstname order, often followed by "ur." / "ed." / "eds."'
    ),
    "author_hint_single": (
        '{"surname":"...","given_name":"..."}. Name in Lastname, Firstname order.'
    ),
}


def hints_for(form: str) -> dict:
    """Return form-specific hint substitutions for typed prompts."""
    return _BIBLIOGRAPHY_HINTS if form == "bibliography" else _FOOTNOTE_HINTS




def classify_by_regex(segment_text: str) -> "CitationType":
    """Pick a citation type from structural markers in the text.

    Falls back to BOOK when nothing matches (the most common type, and the
    field schema overlaps enough with most others that VL can still extract
    real content even when the fallback isn't perfect).
    """
    s = segment_text.strip()
    if not s:
        return CitationType.OTHER
    if is_short_reference(s):
        return CitationType.SHORT_REFERENCE
    if _URL_RE.search(s):
        return CitationType.WEB_SOURCE
    if _DEGREE_RE.search(s):
        return CitationType.THESIS_DISSERTATION
    if _INTERVIEW_RE.search(s):
        return CitationType.INTERVIEW
    if _EXHIBITION_RE.search(s):
        return CitationType.EXHIBITION_CATALOG
    # Book chapter requires explicit "in:"/"v:" marker followed by a title.
    # "ed." alone doesn't qualify (a regular book can have an editor field).
    if _IN_BOOK_RE.search(s):
        return CitationType.BOOK_CHAPTER
    # Journal article: volume+issue patterns and a page range, NO publisher in parens
    has_vol_issue = bool(
        (_VOL_RE.search(s) and _NO_RE.search(s))
        or _JOURNAL_NUMBER_RE.search(s)
        or _JOURNAL_SLASH_RE.search(s)
    )
    has_pages = bool(_PAGE_RANGE_RE.search(s))
    has_publisher_parens = bool(re.search(r"\([A-Z][^)]*?:\s*[A-Z][^)]*?,\s*\d{4}\)", s))
    if has_vol_issue and has_pages and not has_publisher_parens:
        return CitationType.JOURNAL_ARTICLE
    # Newspaper: full date + newspaper-name marker
    has_full_date = bool(_FULL_DATE_EN_RE.search(s) or _FULL_DATE_SL_RE.search(s))
    if has_full_date and _NEWSPAPER_RE.search(s):
        return CitationType.NEWSPAPER_ARTICLE
    # Magazine: full date but no newspaper name
    if has_full_date and not _IN_BOOK_RE.search(s):
        return CitationType.MAGAZINE_ARTICLE
    # Default: book
    return CitationType.BOOK


# ── VL prompts: classification (Call 1) ──────────────────────────────────────
# Short, schema-as-example, in the style of the original generic prompt.

SYSTEM_CLASSIFY = "Classify citation type. JSON only."

CLASSIFY_TEMPLATE = """\
Citation:
{segment}

Type? book | book_chapter | journal_article | magazine_article | newspaper_article | web_source | exhibition_catalog | interview | thesis_dissertation | other

Hints: journal has volume+issue, no publisher. book_chapter has "in"/"v:" + editors. web has URL.

Reply: {{"type":"..."}}"""

CLASSIFY_PREFILL = '{"type":"'
CLASSIFY_MAX_TOKENS = 25


# ── VL prompts: typed extraction (Call 2) ────────────────────────────────────
# Terse schema-as-example, one per type. The 1.6B model copies the shape.

SYSTEM_EXTRACT_TYPED = (
    "Output only JSON. Copy fields verbatim from the text. "
    "Use null for absent fields. Never paraphrase or invent."
)


_BOOK_TEMPLATE = """\
Citation text:
{segment}

This is a {style} book citation. Extract:
- authors: {author_hint}
- title: book title
- subtitle: after a colon in the title, if present
- translator: name after "prev." / "trans." / "translated by"
- editor: name after "ur." / "ed." / "edited by"
- edition: edition number if specified
- publisher: publishing house
- city: place of publication
- year: 4-digit year
- pages: page reference if footnote cites a page

Reply: {{"authors":[{{"surname":"","given_name":""}}],"title":"","subtitle":null,"translator":null,"editor":null,"edition":null,"publisher":"","city":"","year":NNNN,"pages":null}}"""


_BOOK_CHAPTER_TEMPLATE = """\
Citation text:
{segment}

This is a {style} book chapter citation. Extract:
- authors: {author_hint} — the chapter author(s)
- chapter_title: title of the chapter (often in quotes)
- book_title: title of the book containing the chapter (after "in" / "v:")
- editors: {author_hint_editor} — book editors (after "ed." / "ur.")
- publisher
- city
- year: 4-digit year
- pages: page range of the chapter

Reply: {{"authors":[{{"surname":"","given_name":""}}],"chapter_title":"","book_title":"","editors":[{{"surname":"","given_name":""}}],"publisher":"","city":"","year":NNNN,"pages":""}}"""


_JOURNAL_ARTICLE_TEMPLATE = """\
Citation text:
{segment}

This is a {style} journal article citation. Journal articles have NO publisher and NO city. Extract:
- authors: {author_hint}
- article_title: the article's title (often in quotes)
- journal: the journal name (often italicised)
- volume: volume number (e.g. "22")
- issue: issue number after "no." / "št." (e.g. "79")
- year: 4-digit year
- pages: page range (e.g. "117-139")
- doi: DOI if present

Reply: {{"authors":[{{"surname":"","given_name":""}}],"article_title":"","journal":"","volume":"","issue":"","year":NNNN,"pages":"","doi":null}}"""


_MAGAZINE_ARTICLE_TEMPLATE = """\
Citation text:
{segment}

This is a {style} magazine article citation. Extract:
- authors: {author_hint}
- article_title: the article's title
- magazine: the magazine name
- date: full date (month + year, day if available)
- pages: page reference if any
- url: URL if any

Reply: {{"authors":[{{"surname":"","given_name":""}}],"article_title":"","magazine":"","date":"","pages":null,"url":null}}"""


_NEWSPAPER_ARTICLE_TEMPLATE = """\
Citation text:
{segment}

This is a {style} newspaper article citation. Extract:
- authors: {author_hint}
- article_title: the article's title
- newspaper: the newspaper name
- date: full date with day
- section: section name if any
- page: page number if any
- url: URL if any

Reply: {{"authors":[{{"surname":"","given_name":""}}],"article_title":"","newspaper":"","date":"","section":null,"page":null,"url":null}}"""


_WEB_SOURCE_TEMPLATE = """\
Citation text:
{segment}

This is a {style} web source citation. Extract:
- authors: {author_hint} (may be empty if org/no author)
- title: page or article title
- site_name: the site or blog name
- date_published: publication date if any
- accessed_date: access date if any (after "accessed" / "pridobljeno")
- url: the URL

Reply: {{"authors":[{{"surname":"","given_name":""}}],"title":"","site_name":"","date_published":null,"accessed_date":null,"url":""}}"""


_EXHIBITION_CATALOG_TEMPLATE = """\
Citation text:
{segment}

This is a {style} exhibition catalog citation. Extract:
- title: catalog title
- editors: {author_hint_editor}
- curators: list of {{"surname":"...","given_name":"..."}}
- venue: the gallery, museum, or institution hosting the exhibition
- city
- publisher
- year: 4-digit year
- exhibition_dates: date range of the exhibition, if specified

Reply: {{"title":"","editors":[{{"surname":"","given_name":""}}],"curators":[{{"surname":"","given_name":""}}],"venue":"","city":"","publisher":null,"year":NNNN,"exhibition_dates":null}}"""


_INTERVIEW_TEMPLATE = """\
Citation text:
{segment}

This is a {style} interview citation. Extract:
- interviewee: {author_hint_single} (the person being interviewed)
- interviewer: {author_hint_single} (the person conducting the interview)
- title_or_program: title of the interview or name of the program
- publication_or_network: where the interview appeared
- date: full date
- medium: "print" | "radio" | "tv" | "web"
- url: URL if any

Reply: {{"interviewee":{{"surname":"","given_name":""}},"interviewer":{{"surname":"","given_name":""}},"title_or_program":null,"publication_or_network":null,"date":"","medium":null,"url":null}}"""


_THESIS_DISSERTATION_TEMPLATE = """\
Citation text:
{segment}

This is a {style} thesis or dissertation citation. Extract:
- authors: {author_hint} (usually one)
- title: thesis title
- degree_type: "PhD" | "MA" | "doktorska" | "magistrsko" | "diplomsko"
- institution: the university
- year: 4-digit year
- url: URL if any

Reply: {{"authors":[{{"surname":"","given_name":""}}],"title":"","degree_type":"","institution":"","year":NNNN,"url":null}}"""


_OTHER_TEMPLATE = """\
Citation text:
{segment}

This citation doesn't fit standard types. Extract whatever you can:
- authors: {author_hint} if any
- title: title if any
- raw_text: the citation as a single string, verbatim
- notes: brief description of what type this looks like

Reply: {{"authors":[],"title":null,"raw_text":"","notes":""}}"""


_PREFILLS: dict[CitationType, str] = {
    CitationType.BOOK: '{"authors":',
    CitationType.BOOK_CHAPTER: '{"authors":',
    CitationType.JOURNAL_ARTICLE: '{"authors":',
    CitationType.MAGAZINE_ARTICLE: '{"authors":',
    CitationType.NEWSPAPER_ARTICLE: '{"authors":',
    CitationType.WEB_SOURCE: '{"authors":',
    CitationType.EXHIBITION_CATALOG: '{"title":"',
    CitationType.INTERVIEW: '{"interviewee":',
    CitationType.THESIS_DISSERTATION: '{"authors":',
    CitationType.OTHER: '{"authors":',
}


_TEMPLATES: dict[CitationType, str] = {
    CitationType.BOOK: _BOOK_TEMPLATE,
    CitationType.BOOK_CHAPTER: _BOOK_CHAPTER_TEMPLATE,
    CitationType.JOURNAL_ARTICLE: _JOURNAL_ARTICLE_TEMPLATE,
    CitationType.MAGAZINE_ARTICLE: _MAGAZINE_ARTICLE_TEMPLATE,
    CitationType.NEWSPAPER_ARTICLE: _NEWSPAPER_ARTICLE_TEMPLATE,
    CitationType.WEB_SOURCE: _WEB_SOURCE_TEMPLATE,
    CitationType.EXHIBITION_CATALOG: _EXHIBITION_CATALOG_TEMPLATE,
    CitationType.INTERVIEW: _INTERVIEW_TEMPLATE,
    CitationType.THESIS_DISSERTATION: _THESIS_DISSERTATION_TEMPLATE,
    CitationType.OTHER: _OTHER_TEMPLATE,
}


def prompt_for_type(
    citation_type: CitationType,
    segment_text: str,
    style: CitationStyle = CitationStyle.UNKNOWN,
    form: str = "footnote",
) -> tuple[str, str, int]:
    """Return (user_prompt, prefill, max_tokens) for typed extraction.

    `form` ∈ {"footnote", "bibliography"} selects the author-order hint
    embedded in the prompt — footnote-form ("Firstname Lastname") and
    bibliography-form ("Lastname, Firstname") are structurally different
    and must not share an instruction.
    """
    template = _TEMPLATES.get(citation_type)
    if template is None:
        template = _OTHER_TEMPLATE
        citation_type = CitationType.OTHER
    prefill = _PREFILLS.get(citation_type, '{"authors":')
    hints = hints_for(form)
    user = template.format(
        segment=segment_text[:800],
        style=style.value,
        **hints,
    )
    # 600 tokens fits a fully-populated book_chapter with multiple authors
    # and editors. Smaller types use less; this is the upper bound that
    # avoids mid-emission truncation.
    return user, prefill, 600
